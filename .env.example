# Copy file này thành .env rồi điền API key
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxx
# Slug model trên OpenRouter (kiểm tra lại tại https://openrouter.ai/models)
LLM_MODEL=deepseek/deepseek-v4-flash
LLM_TEMPERATURE=0.2

# Bộ dữ liệu: data/tap-mau-thuoc.csv (tiếng Việt, mặc định) hoặc data/ds-thuoc-dailymed.csv (tiếng Anh)
# Chỉ mục lưu riêng ở storage/<tên file>/
DATA_CSV=data/tap-mau-thuoc.csv

# Embedding đa ngôn ngữ chạy local (câu hỏi tiếng Việt <-> dữ liệu tiếng Anh)
EMBEDDING_MODEL=intfloat/multilingual-e5-small
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
TOP_K=6
